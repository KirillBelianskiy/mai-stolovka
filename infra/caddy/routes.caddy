(edge_http) {
	encode zstd gzip
	log {
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			resp_headers>Set-Cookie delete
			request>headers>X-Telegram-Bot-Api-Secret-Token delete
			request>uri query {
				delete token
				delete access_token
				delete initData
				delete init_data
				delete tgWebAppData
			}
		}
	}
	header -Server
}

(staff_login_limit) {
	rate_limit {
		zone staff_login {
			key {remote_host}
			events 10
			window 1m
		}
	}
}
