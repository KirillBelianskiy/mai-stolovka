# Export these variables before running the service on the host.
# Set the URL for database-backed services only; use the matching service credentials.
APP_DATABASE_URL=
APP_READINESS_TIMEOUT_SECONDS=2
APP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_JWT_PUBLIC_KEY_BASE64=
APP_JWT_ISSUER=mai-food-users
APP_JWT_AUDIENCE=mai-food-api
APP_JWT_KEY_ID=local-v1
APP_ALLOWED_ORIGINS=http://localhost:8081
APP_WEBSOCKET_AUTH_TIMEOUT_SECONDS=5
APP_WEBSOCKET_MAX_FRAME_BYTES=12288
APP_WEBSOCKET_QUEUE_SIZE=128
