# Export explicitly for host development; this file is not loaded automatically.
APP_DATABASE_URL=
APP_READINESS_TIMEOUT_SECONDS=2
# Base64-encoded RSA public PEM from User Service; never copy its private key here.
APP_JWT_PUBLIC_KEY_BASE64=
APP_JWT_ISSUER=mai-food-users
APP_JWT_AUDIENCE=mai-food-api
APP_JWT_KEY_ID=local-v1
APP_ROOT_PATH=
APP_MENU_BASE_URL=http://localhost:8080/api/v1/menu
APP_MENU_TIMEOUT_SECONDS=2
APP_SNAPSHOT_MAX_AGE_SECONDS=5
APP_TRANSACTION_LOCK_TIMEOUT_MS=1000
APP_TRANSACTION_STATEMENT_TIMEOUT_MS=3000
# Standalone worker only; HTTP startup never launches it.
APP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_OUTBOX_TOPIC=orders.events.v1
APP_OUTBOX_POLL_SECONDS=1
APP_OUTBOX_SEND_TIMEOUT_SECONDS=30
APP_OUTBOX_SHUTDOWN_TIMEOUT_SECONDS=5
APP_OUTBOX_GUARD_INTERVAL_SECONDS=1
APP_OUTBOX_METRICS_INTERVAL_SECONDS=30
APP_OUTBOX_BACKLOG_ALERT_SECONDS=60
APP_OUTBOX_RETRY_ALERT_SECONDS=300
