# Export these variables before running the service on the host.
# Set the URL for database-backed services only; use the matching service credentials.
APP_DATABASE_URL=
APP_READINESS_TIMEOUT_SECONDS=2
APP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Exact browser origins allowed to establish/restore/revoke Mini App sessions.
APP_SESSION_COOKIE_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# Dedicated Notification service public key; never reuse the end-user JWT key.
APP_NOTIFICATION_SERVICE_PUBLIC_KEY_BASE64=
APP_NOTIFICATION_SERVICE_ISSUER=mai-food-notification
APP_NOTIFICATION_SERVICE_AUDIENCE=mai-food-user
APP_NOTIFICATION_SERVICE_KEY_ID=notification-v1
# Set the same random value as Telegram's configured webhook secret token.
APP_TELEGRAM_WEBHOOK_SECRET=
