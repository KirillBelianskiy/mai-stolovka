# Export these variables before running the service on the host.
# Set the URL for database-backed services only; use the matching service credentials.
APP_DATABASE_URL=
APP_READINESS_TIMEOUT_SECONDS=2
APP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Standalone ingestion only; HTTP never starts it automatically.
APP_INBOX_TOPIC=orders.events.v1
APP_INBOX_GROUP=notification-orders-v1
APP_INBOX_OPERATION_TIMEOUT_SECONDS=15
APP_INBOX_SHUTDOWN_TIMEOUT_SECONDS=10

# Standalone READY dispatcher. HTTP and inbox startup never launch it.
APP_DISPATCH_BOT_MODE=disabled
# Required in fake mode. Supply a disposable fake server origin and omit the bot token.
# APP_DISPATCH_FAKE_BOT_URL=http://127.0.0.1:8089
# Required only in separately authorized telegram mode.
# APP_DISPATCH_BOT_TOKEN=
# Private User service origin, with no path. Use HTTPS outside a trusted private network.
# APP_DISPATCH_USER_URL=http://user-service:8000
# Dedicated base64-encoded RSA private PEM. User receives only the matching public key.
# APP_DISPATCH_SIGNING_KEY_BASE64=
APP_DISPATCH_TOKEN_ISSUER=mai-food-notification
APP_DISPATCH_TOKEN_AUDIENCE=mai-food-user
APP_DISPATCH_TOKEN_KEY_ID=notification-v1
