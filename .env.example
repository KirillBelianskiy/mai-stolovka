# Local development only. Generate each password with: openssl rand -hex 24
# Use hexadecimal passwords here so they are safe in connection URLs.
POSTGRES_PASSWORD=
USERS_DB_PASSWORD=
MENU_DB_PASSWORD=
ORDERS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
# Synthetic wallet credit and checkout debit; no real payment provider.
ORDER_DEMO_PAYMENTS_ENABLED=false
POSTGRES_PORT=5432
KAFKA_PORT=9092
MINI_APP_PORT=8080
KITCHEN_APP_PORT=8081
API_ONLY_PORT=8082

# Add exact HTTPS Pages preview origins to these comma-separated lists before testing.
# Keep production origins out of this test-only configuration; never add a wildcard.
SESSION_COOKIE_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8081

# Generate JWT keys using: python3 infra/create-auth-env.py
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
# Supply a real BotFather token to enable Telegram login; never use a demo token.
TELEGRAM_BOT_TOKEN=
NOTIFICATION_SERVICE_PUBLIC_KEY_BASE64=
TELEGRAM_WEBHOOK_SECRET=
