{
  "components": {
    "schemas": {
      "BlockObservation": {
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "notification_id": {
            "format": "uuid",
            "title": "Notification Id",
            "type": "string"
          },
          "reason": {
            "enum": [
              "bot_forbidden",
              "private_chat_blocked"
            ],
            "title": "Reason",
            "type": "string"
          },
          "telegram_user_id": {
            "exclusiveMinimum": 0.0,
            "maximum": 9.223372036854776e+18,
            "title": "Telegram User Id",
            "type": "integer"
          }
        },
        "required": [
          "expected_revision",
          "telegram_user_id",
          "notification_id",
          "reason"
        ],
        "title": "BlockObservation",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "LoginResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserProfile"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "user"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "ProfileUpdate": {
        "additionalProperties": false,
        "properties": {
          "full_name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          }
        },
        "required": [
          "full_name"
        ],
        "title": "ProfileUpdate",
        "type": "object"
      },
      "RecipientPermissionState": {
        "enum": [
          "unknown",
          "allowed",
          "blocked"
        ],
        "title": "RecipientPermissionState",
        "type": "string"
      },
      "RecipientSnapshot": {
        "properties": {
          "evidence_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Kind"
          },
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "state": {
            "$ref": "#/components/schemas/RecipientPermissionState"
          },
          "telegram_chat_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Telegram Chat Id"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "state",
          "telegram_chat_id",
          "revision",
          "observed_at",
          "evidence_kind"
        ],
        "title": "RecipientSnapshot",
        "type": "object"
      },
      "Role": {
        "enum": [
          "CLIENT",
          "COOK",
          "CASHIER",
          "ADMIN"
        ],
        "title": "Role",
        "type": "string"
      },
      "StaffLogin": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "maxLength": 64,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "StaffLogin",
        "type": "object"
      },
      "TelegramLogin": {
        "additionalProperties": false,
        "properties": {
          "init_data": {
            "maxLength": 16384,
            "minLength": 1,
            "title": "Init Data",
            "type": "string"
          }
        },
        "required": [
          "init_data"
        ],
        "title": "TelegramLogin",
        "type": "object"
      },
      "TelegramWebhookChat": {
        "properties": {
          "id": {
            "exclusiveMinimum": 0.0,
            "maximum": 9.223372036854776e+18,
            "title": "Id",
            "type": "integer"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "title": "TelegramWebhookChat",
        "type": "object"
      },
      "TelegramWebhookMessage": {
        "properties": {
          "chat": {
            "$ref": "#/components/schemas/TelegramWebhookChat"
          },
          "date": {
            "exclusiveMinimum": 0.0,
            "title": "Date",
            "type": "integer"
          },
          "from": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TelegramWebhookUser"
              },
              {
                "type": "null"
              }
            ]
          },
          "write_access_allowed": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Write Access Allowed"
          }
        },
        "required": [
          "chat",
          "date"
        ],
        "title": "TelegramWebhookMessage",
        "type": "object"
      },
      "TelegramWebhookUpdate": {
        "properties": {
          "message": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TelegramWebhookMessage"
              },
              {
                "type": "null"
              }
            ]
          },
          "update_id": {
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Update Id",
            "type": "integer"
          }
        },
        "required": [
          "update_id"
        ],
        "title": "TelegramWebhookUpdate",
        "type": "object"
      },
      "TelegramWebhookUser": {
        "properties": {
          "id": {
            "exclusiveMinimum": 0.0,
            "maximum": 9.223372036854776e+18,
            "title": "Id",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "title": "TelegramWebhookUser",
        "type": "object"
      },
      "UserProfile": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "telegram_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Telegram Id"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "required": [
          "id",
          "telegram_id",
          "username",
          "full_name",
          "role",
          "created_at"
        ],
        "title": "UserProfile",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "MAI Food — User Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/logout": {
      "post": {
        "description": "Revokes the presented Mini App session when present and clears its cookie. Requires an allowlisted Origin. Existing access JWTs remain valid until expiry.",
        "operationId": "logout_auth_logout_post",
        "parameters": [
          {
            "in": "header",
            "name": "origin",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Origin"
            }
          },
          {
            "in": "cookie",
            "name": "mai_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mai Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "accounts"
        ]
      }
    },
    "/auth/session": {
      "post": {
        "description": "Restores the Mini App identity from the mai_session cookie and issues a fresh access JWT. Requires an allowlisted Origin.",
        "operationId": "restore_session_auth_session_post",
        "parameters": [
          {
            "in": "header",
            "name": "origin",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Origin"
            }
          },
          {
            "in": "cookie",
            "name": "mai_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mai Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Restore Session",
        "tags": [
          "accounts"
        ]
      }
    },
    "/auth/staff": {
      "post": {
        "operationId": "staff_login_auth_staff_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StaffLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Staff Login",
        "tags": [
          "accounts"
        ]
      }
    },
    "/auth/telegram": {
      "post": {
        "description": "Validates fresh Telegram initData, creates a revocable browser session, and sets the Secure, HttpOnly mai_session cookie. Requires an allowlisted Origin.",
        "operationId": "telegram_login_auth_telegram_post",
        "parameters": [
          {
            "in": "header",
            "name": "origin",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Origin"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelegramLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Telegram Login",
        "tags": [
          "accounts"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/internal/v1/notification-recipients/{user_id}": {
      "get": {
        "operationId": "resolve_recipient_internal_v1_notification_recipients__user_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipientSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Resolve Recipient",
        "tags": [
          "notification recipients"
        ]
      }
    },
    "/internal/v1/notification-recipients/{user_id}/blocked": {
      "post": {
        "operationId": "report_block_internal_v1_notification_recipients__user_id__blocked_post",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlockObservation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipientSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Report Block",
        "tags": [
          "notification recipients"
        ]
      }
    },
    "/internal/v1/telegram/webhook": {
      "post": {
        "operationId": "telegram_webhook_internal_v1_telegram_webhook_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Telegram-Bot-Api-Secret-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Telegram-Bot-Api-Secret-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelegramWebhookUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Telegram Webhook",
        "tags": [
          "notification recipients"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "profile_me_get",
        "responses": {
          "200": {
